# V2 backend — domain-scoped API, separate from the T2.8 reference backend.
# JWT_SECRET MUST match the reference backend's JWT_SECRET: V2 does not
# reimplement login, it verifies tokens the reference backend already issued
# (Foundation's AuthContext logs in against the reference backend's
# POST /api/auth/login and stores that token; this server verifies it).
JWT_SECRET=
PORT=5001
DB_HOST=localhost
DB_PORT=5555
DB_NAME=gurmad_v2_db
DB_USER=gurmad_staging
DB_PASSWORD=staging_local_only_pw
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Phase 4 — Customer Portal. Must be different from JWT_SECRET (OD-1) —
# server refuses to start otherwise.
CUSTOMER_PORTAL_JWT_SECRET=
# Phase 4 — OD-6: WhatsApp password-reset delivery provider. Leave unset in
# any environment without real provider credentials — the portal will
# honestly report non-delivery rather than fake success.
WHATSAPP_PROVIDER_API_URL=
WHATSAPP_PROVIDER_API_KEY=
CUSTOMER_PORTAL_WEB_URL=http://localhost:5180
